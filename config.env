# ============ 内核源码配置 ============
# 小米6官方开源内核 (Android 9 Pie, kernel 4.4)
KERNEL_SOURCE=https://github.com/MiCode/Xiaomi_Kernel_OpenSource
KERNEL_SOURCE_BRANCH=sagit-p-oss

# 内核defconfig名称
KERNEL_CONFIG=sagit_user_defconfig

# 编译产物内核镜像名（小米6用 Image.gz-dtb）
KERNEL_IMAGE_NAME=Image.gz-dtb

# 最终打包zip文件名
KERNEL_ZIP_NAME=MI6-sagit-KernelSU-Docker-LXC

# ============ 功能开关 ============
# 是否开启 KernelSU
ENABLE_KERNELSU=true
# KernelSU 版本：v0.9.5 是最后一个官方支持非GKI(4.4)内核的版本
KERNELSU_TAG=v0.9.5

# 是否开启 Docker / LXC 容器支持
ENABLE_LXC_DOCKER=true

# 是否开启 KVM 虚拟化（一般用户不需要）
ENABLE_KVM=false

# ============ 编译器配置 ============
# 4.4内核不要使用 LLVM=1 LLVM_IAS=1！使用混合模式最稳定
LLVM_CONFIG=n

# ============ 其他选项 ============
# 切换python2（4.4内核构建需要）
SWITCH_PYTHON=true
# 小米6不需要dtbo
NEED_DTBO=false
