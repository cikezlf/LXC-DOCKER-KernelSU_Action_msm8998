# ============ 内核源码配置 ============
# 小米6官方开源内核 (Android 9 Pie, kernel 4.4)
KERNEL_SOURCE=https://github.com/MiCode/Xiaomi_Kernel_OpenSource
KERNEL_SOURCE_BRANCH=sagit-p-oss

# 内核defconfig名称
KERNEL_CONFIG=sagit_defconfig

# 编译产物内核镜像名（小米6用 Image.gz-dtb）
KERNEL_IMAGE_NAME=Image.gz-dtb

# 最终打包zip文件名
KERNEL_ZIP_NAME=MI6-sagit-KernelSU-Docker-LXC

# ============ 功能开关 ============
# 是否开启 KernelSU（true 开启）
ENABLE_KERNELSU=true
# KernelSU 版本：v0.9.5 是最后一个官方支持非GKI(4.4)内核的版本
KERNELSU_TAG=v0.9.5

# 是否开启 Docker / LXC 容器支持（true 开启）
ENABLE_LXC_DOCKER=true

# 是否开启 KVM 虚拟化（一般用户不需要，false即可）
ENABLE_KVM=false

# ============ 编译器配置 ============
# 重要：4.4内核 不要使用 LLVM=1 LLVM_IAS=1！会大量汇编报错
# 这里用 Clang 编译 + GNU as 汇编器混合模式（最稳定）
LLVM_CONFIG=n

# ============ 其他选项 ============
# 是否需要切换python2（4.4内核构建某些脚本需要python2）
SWITCH_PYTHON=true
# 是否需要单独打包 dtbo.img（小米6不需要）
NEED_DTBO=false
