# ============================================================
# 小米6（sagit）Docker/LXC + KernelSU-Next 内核编译配置
# 说明：本文件中被工作流引用的变量会真正生效；
#       未被引用的变量已在注释中标明，避免误以为改了有用。
# ============================================================

# ==================== 一、内核源码 ====================
# 内核源码地址
# 默认：小米官方开源内核（MiCode）。社区普遍反馈「官方源码编译后刷入 MIUI 开不了机」，
#       若目标是在 MIUI 上稳定开机，更建议改用第三方维护的源码，例如：
#       https://github.com/LineageOS/android_kernel_xiaomi_msm8998 （分支参考 lineage-19.1 / lineage-18.1）
KERNEL_SOURCE=https://github.com/MiCode/Xiaomi_Kernel_OpenSource.git

# 内核源码分支
KERNEL_SOURCE_BRANCH=sagit-p-oss

# 内核编译配置（对应 arch/arm64/configs/ 下的 defconfig 文件名）
# 官方 sagit-p-oss 用 sagit_user_defconfig；若换 LineageOS 源码，一般用 sagit_defconfig
KERNEL_CONFIG=sagit_user_defconfig

# 选择要打包的内核镜像文件
# 低端机填 Image.gz-dtb（4.4 高通机型一般用这个）
# 高端机可选 Image.gz 或 Image
KERNEL_IMAGE_NAME=Image.gz-dtb

# 内核 zip 包名，自定义，支持英文数字
KERNEL_ZIP_NAME=sagit_lxc-docker-kernel

# ==================== 二、编译工具链 ====================
# Clang 工具链分支（对应 prebuilts/clang/host/linux-x86 的分支）
# 注意：android13-release / clang-r450784d 属于很新的工具链，用它编 4.4 老内核
#       需要大量兼容补丁。若想减少补丁量，可换成与内核基线匹配的旧分支。
CLANG_BRANCH=android13-release

# Clang 工具链目录名（对应仓库下的 clang-rXXXXXXX 目录）
CLANG_VERSION=clang-r450784d

# 是否需要 LLVM=1 LLVM_IAS=1 参数
# 4.4 老内核一般用 GNU as 汇编，保持 n；仅当源码明确支持集成汇编器时填 y
LLVM_CONFIG=n

# ==================== 三、功能开关 ====================
# 是否开启 kvm（90% 的用户用不到，false 即可）
# 注意：当前工作流未接线该开关，改这里不会生效（KVM 需要另加 CONFIG_KVM 相关写入步骤）
ENABLE_KVM=false

# 是否开启 lxc-docker（true=写入并校验 Docker/LXC 所需的全部内核选项）
ENABLE_LXC_DOCKER=true

# 是否需要切换 python2（Ubuntu 22.04 已无独立 python2 包，一般 false）
SWITCH_PYTHON=false

# 是否需要 dtbo（4.4 老机型一般不需要，false 即可）
NEED_DTBO=false

# ==================== 四、KernelSU / root ====================
# 是否需要 ksu（true=编译时集成 KernelSU 驱动）
ENABLE_KERNELSU=true

# KSU 方案：legacy（对应非 GKI 的 4.x 内核，走手动 hook）
# 注意：当前工作流固定调用 ksu-legacy-setup.sh，本项仅作标记，改这里不会切换脚本
KERNELSU_TAG=legacy

# ==================== 五、AnyKernel3 刷机包 ====================
# 是否开启机型校验（1=开启，仅允许目标机型刷入，更安全；0=关闭，可跨机型刷，有变砖风险）
AK3_DEVICECHECK=1

# 机型代号（小米6 = sagit）
AK3_DEVICE_NAME=sagit
