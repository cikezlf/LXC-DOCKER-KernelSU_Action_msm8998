# ==============================================
# KernelSU-Next v3.4.0-legacy 小米6官方内核配置
# 无任何v0.9.5原版KernelSU内容
# ==============================================

# 小米6官方开源内核（已验证分支/defconfig存在）
KERNEL_SOURCE=https://github.com/MiCode/Xiaomi_Kernel_OpenSource.git
KERNEL_SOURCE_BRANCH=sagit-p-oss
KERNEL_CONFIG=sagit_defconfig
KERNEL_IMAGE_NAME=Image.gz-dtb
KERNEL_ZIP_NAME=MI6-KernelSU-Next-Docker-LXC.zip

# KernelSU-Next v3.4.0-legacy 专用配置（匹配ksu-legacy-setup.sh）
ENABLE_KERNELSU=true
KSU_VERSION=v3.4.0-legacy
KSU_EXPECTED_SIZE=0x3e6
KSU_EXPECTED_HASH=79e590113c4c4c0c222978e413a5faa801666957b1212a328e46c00c69821bf7
KSU_MANAGER_PACKAGE=io.github.kernelsu.manager

# 工具链（和lineage-20成功编译模板一致）
LLVM_CONFIG=y
CLANG_BRANCH=android13-release
CLANG_VERSION=r450784d
GCC_64_VERSION=aarch64-linux-android-4.9
GCC_32_VERSION=arm-linux-androideabi-4.9

# 功能开关
ENABLE_DOCKER=true
ENABLE_LXC=true
ENABLE_KVM=true
SWITCH_PYTHON=true
