# ==============================================
# 小米6(sagit) 官方开源内核 · 卡米修复版配置
# ==============================================

# 内核源码（小米官方开源仓库）
KERNEL_SOURCE=https://github.com/MiCode/Xiaomi_Kernel_OpenSource

# 内核源码分支
# 手机系统是 Android 9（MIUI 11，日志 ro.zygote=zygote64_32），
# 必须用 p 分支。仓库里 sagit 只有三个分支：sagit-n-oss(安卓7)/sagit-o-oss(安卓8)/sagit-p-oss(安卓9)
KERNEL_SOURCE_BRANCH=sagit-p-oss

# 内核编译配置
# 【关键】该分支（以及 n/o/p 三个分支）里真实存在的文件只有 sagit_user_defconfig，
# 仓库中根本不存在 sagit_defconfig。写错会在第六步直接中断：
#   *** Can't find default configuration "arch/arm64/configs/sagit_defconfig"!
KERNEL_CONFIG=sagit_user_defconfig

# 打包名
KERNEL_ZIP_NAME=sagit_lxc-docker-kernel

# 镜像文件名（小米6 是低端机路线，4.4 内核标准输出 Image.gz-dtb）
KERNEL_IMAGE_NAME=Image.gz-dtb

# 是否为 4.4 内核：kbuild 不支持 LLVM=1 / LLVM_IAS=1，必须 n
LLVM_CONFIG=n

# 【先关掉，验证能开机后再加回来】
# KernelSU 在 4.4 上走 legacy hook 补丁，属于额外风险项；
# 同机型已跑通的参考配置里 KSU 是关闭的。先确认内核本身能开机，再逐项加功能。
ENABLE_KERNELSU=false

# KVM 在 4.4 上是额外风险项，先关
ENABLE_KVM=false

# 保留 LXC/Docker 支持
ENABLE_LXC_DOCKER=true

# 是否切换 python2
SWITCH_PYTHON=false

# 是否需要 dtbo（小米6 无独立 dtbo 分区）
NEED_DTBO=false

# ---- 工具链（仅当工作流里 CLANG_BRANCH/CLANG_VERSION 已改为读变量时才生效）----
# 说明：4.4 老内核 + 过新的 AOSP Clang 会引入一大堆兼容性补丁（嵌套函数、
# bcmp/stpcpy、current_stack_pointer、spinlock 立即数约束），每个补丁都可能
# 造成"能编译、跑不起来"。同机型跑通的参考用的是 android12-release 的 Clang(12.0.5)。
CLANG_BRANCH=android12-release
CLANG_VERSION=r416183b
