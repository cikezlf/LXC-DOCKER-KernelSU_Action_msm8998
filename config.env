# 小米6官方开源内核编译配置文件
# 内核源码地址：小米官方开源仓库
KERNEL_SOURCE=https://github.com/MiCode/Xiaomi_Kernel_OpenSource

# 内核源码分支：小米6(sagit)官方安卓8.0开源分支
KERNEL_SOURCE_BRANCH=sagit-o-oss

# 内核编译配置：小米6官方默认defconfig
KERNEL_CONFIG=sagit_defconfig

# 内核打包名字
KERNEL_ZIP_NAME=sagit_official_kernel_lxc-docker-ksu

# 是否开启kvm
ENABLE_KVM=false

# 是否开启lxc-docker支持
ENABLE_LXC_DOCKER=true

# 选择要打包的内核镜像文件：小米6为arm64低端机使用Image.gz-dtb
KERNEL_IMAGE_NAME=Image.gz-dtb

# 是否需要LLVM=1 LLVM_IAS=1参数，官方4.4内核使用GCC交叉编译即可，设为n
LLVM_CONFIG=n

# 是否需要切换python2，官方4.4内核编译需要python2，设为true
SWITCH_PYTHON=true

# 是否需要dtbo，小米6不需要，false即可
NEED_DTBO=false

# ksu部分配置
ENABLE_KERNELSU=true
KERNELSU_TAG=legacy
