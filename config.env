# 内核源码地址（修改为小米6官方开源地址）
KERNEL_SOURCE=https://github.com/MiCode/Xiaomi_Kernel_OpenSource.git

# 内核源码分支（修改为小米6官方sagit-p-oss分支）
KERNEL_SOURCE_BRANCH=sagit-p-oss

# 内核编译配置（官方分支真实存在的defconfig，已验证）
KERNEL_CONFIG=sagit_user_defconfig

# 内核打包名字，自定义，支持英文数字
KERNEL_ZIP_NAME=MI6-Official-Kernel-Docker-LXC-KernelSU-Next
# 是否开启kvm
ENABLE_KVM=false

# 是否开启lxc-docker
ENABLE_LXC_DOCKER=true

# 选择要打包的内核镜像文件
KERNEL_IMAGE_NAME=Image.gz-dtb

# 是否需要LLVM=1 LLVM_IAS=1参数
LLVM_CONFIG=y

# 是否需要切换python2
SWITCH_PYTHON=false
# 是否需要dtbo
NEED_DTBO=false

# KernelSU-Next配置（和成功版一致，legacy分支适配4.4内核）
ENABLE_KERNELSU=true
#KERNELSU_TAG=legacy
KERNELSU_TAG=v3.4.0-legacy
