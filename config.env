# 内核源码配置
KERNEL_SOURCE=https://github.com/MiCode/Xiaomi_Kernel_OpenSource.git
KERNEL_SOURCE_BRANCH=sagit-p-oss
KERNEL_CONFIG=sagit_user_defconfig
KERNEL_IMAGE_NAME=Image.gz-dtb
KERNEL_ZIP_NAME=MI6-Kernel-Docker-LXC-KernelSU.zip

# KernelSU配置
ENABLE_KERNELSU=true
KSU_VERSION=v3.4.0-legacy
KSU_EXPECTED_SIZE=0x033b
KSU_EXPECTED_HASH=c371061b19d8c7d7d6133c6a9bafe198fa944e50c1b31c9d8daa8d7f1fc2d2d6

# 工具链配置
LLVM_CONFIG=y
CLANG_BRANCH=android13-release
CLANG_VERSION=r450784d

# 功能开关
ENABLE_DOCKER=true
ENABLE_LXC=true
ENABLE_KVM=true
SWITCH_PYTHON=true
