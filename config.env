#!/bin/bash
# Kernel Build Environment Config - 小米6 sagit/msm8998 纯GCC稳定版 v5
# 修复：完全放弃Clang/LLVM，使用小米官方同代GCC工具链，解决所有链接阶段错误

# 内核源码配置
KERNEL_DIR="$GITHUB_WORKSPACE/kernel_workspace/android-kernel"
KERNEL_SOURCE="https://github.com/MiCode/Xiaomi_Kernel_OpenSource.git"
KERNEL_BRANCH="sagit-p-oss"
KERNEL_CONFIG="sagit_user_defconfig"

# 工具链配置【核心修复：纯GCC，不用Clang】
TOOLCHAIN_DIR="$GITHUB_WORKSPACE/kernel_workspace/toolchains"
GCC_ARM64_REPO="https://android.googlesource.com/platform/prebuilts/gcc/linux-x86/aarch64/aarch64-linux-android-4.9"
GCC_ARM64_BRANCH="pie-gsi"
GCC_ARM32_REPO="https://android.googlesource.com/platform/prebuilts/gcc/linux-x86/arm/arm-linux-androideabi-4.9"
GCC_ARM32_BRANCH="pie-gsi"
# 关闭LLVM配置，完全使用GCC
LLVM_CONFIG=n

# KernelSU配置
KSU_ENABLE=true
KSU_VERSION="v0.9.5"

# 编译输出
OUT_DIR="$KERNEL_DIR/out"
ANYKERNEL3_DIR="$GITHUB_WORKSPACE/kernel_workspace/AnyKernel3"
ZIP_NAME="MI6-LXC-Docker-KSU-Kernel-v5.zip"

# 功能配置
SWITCH_PYTHON=true
