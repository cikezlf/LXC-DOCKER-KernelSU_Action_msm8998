# 内核源码地址
KERNEL_SOURCE=https://github.com/MiCode/Xiaomi_Kernel_OpenSource.git

# 内核源码分支
# sagit-p-oss = 小米6 官方开源内核，对应 Android 9（与 miui_MI6_V10.4.3.0.PCACNXM 的 “9.0” 匹配）
KERNEL_SOURCE_BRANCH=sagit-p-oss

# 内核编译配置
# 官方仓库三个分支都只有 sagit_user_defconfig，没有 sagit_defconfig，别写错
KERNEL_CONFIG=sagit_user_defconfig

# 内核打包名字，自定义，支持英文数字
KERNEL_ZIP_NAME=sagit_lxc-docker-kernel

# 是否开启kvm
# 百分之90的用户用不到kvm，false即可
ENABLE_KVM=false

# 是否开启lxc-docker，true即可
# 【第一阶段验证】先填 false：不叠加任何 Docker/LXC 配置，用最接近官方原版的内核验证能不能开机
# 验证能开机后，再改成 true 重新编译
ENABLE_LXC_DOCKER=false

# 选择要打包的内核镜像文件
# 低端机填Image.gz-dtb
# 高端机可以选择Image.gz，Image
KERNEL_IMAGE_NAME=Image.gz-dtb

# 是否需要LLVM=1 LLVM_IAS=1参数
# 取决于你的内核源码，一般是需要的
# 需要填y，不需要填n
LLVM_CONFIG=y

# 是否需要切换python2，一般不需要，false即可
SWITCH_PYTHON=false

# 是否需要dtbo，一般不需要，false即可
NEED_DTBO=false

# ksu部分，如果不需要ksu，以下内容都不用改
# 如果需要ksu，值改成true，下面的参数main不用改
# 【第一阶段验证】先填 false：KernelSU 在 4.4 老内核上的 hook 是卡米高发点，先排除它
# 验证能开机后，再改成 true
ENABLE_KERNELSU=false
KERNELSU_TAG=legacy
